// fix 20
// Plak deze regels in: Firebase Console > Firestore Database > Rules > tekst vervangen > Publiceren
//
// Beheer-e-mailadres is al ingevuld: davedebruin123@gmail.com

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /vves/{docId} {

      // Registratie (nog niet ingelogd): mag alleen een NIEUW document aanmaken,
      // met precies deze velden, een leeg moduleAccess-object, en de doc-ID moet
      // gelijk zijn aan het e-mailadres. Voorkomt dat iemand zichzelf alvast
      // toegang tot modules geeft tijdens registratie.
      allow create: if request.resource.data.keys().hasOnly(['email', 'naam', 'moduleAccess', 'createdAt'])
                    && request.resource.data.moduleAccess == {}
                    && request.resource.data.email == docId;

      // Een ingelogde VvE mag alleen het eigen document lezen (e-mail in het
      // Firebase-token moet overeenkomen met de document-ID).
      allow read: if request.auth != null && request.auth.token.email == docId;

      // De beheerder mag alle documenten lezen (voor het beheerscherm) en wijzigen
      // (modules aan/uit zetten).
      allow read, update: if request.auth != null && request.auth.token.email == 'davedebruin123@gmail.com';

      // Niemand mag via de client documenten verwijderen.
      allow delete: if false;
    }
  }
}
